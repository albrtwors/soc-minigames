[gd_resource type="Resource" script_class="NivelTutorialData" format=3]

[ext_resource type="Script" uid="uid://geoqhb1uar6d" path="res://scripts/data/NivelTutorialData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
paginas_teoria = Array[Dictionary]([{
"imagen": null,
"texto": "[b]Objetivo:[/b] Construye y asegura la infraestructura de red de una organización antes de que el tiempo se agote."
}, {
"imagen": null,
"texto": "[b]TOPOLOGÍA (cables):[/b] Click IZQUIERDO sobre un dispositivo lo selecciona. Click IZQUIERDO sobre otro tiende el cable.\n\nCable correcto [b]+200 PTS[/b]. Cable no requerido = error de segmentación [b]-100 PTS[/b]."
}, {
"imagen": null,
"texto": "[b]BASTIONADO (directivas):[/b] Doble click sobre un dispositivo abre sus directivas de seguridad. Activa las correctas para protegerlo.\n\nCada directiva correcta [b]+150 PTS[/b]."
}, {
"imagen": null,
"texto": "[b]AUDITORÍA:[/b] Cuando todo esté listo, pulsa [b]ENTER[/b] o el botón [b]LANZAR TEST[/b].\n\nSi pasas la auditoría → ganas. Si fallas → [b]-150 PTS[/b] y pierdes un intento (máximo 3)."
}, {
"imagen": null,
"texto": "[b]CONSEJO:[/b] Observa los nombres de los dispositivos. Un paquete viaja desde el ROUTER EDGE → FIREWALL → SERVIDORES.\n\n¡Cuida el tiempo! Cada segundo restante vale [b]+10 PTS[/b] de bonificación."
}])
tiene_demo_jugable = false
titulo_ui = "TUTORIAL INFRAESTRUCTURA"
tipo_nivel = 0
