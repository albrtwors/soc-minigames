[resource]
script = ExtResource("1_script")
paginas_teoria = Array[Dictionary]([{
"imagen": null,
"texto": "[b]NIVEL 11 - ARQUITECTURA TRES CAPAS[/b]\n\nArquitectura profesional de tres capas: acceso (ROUTER EDGE), distribución (SWITCH CORE + FIREWALL) y datos (servidores). Nueva conexión segura: [b]BASTIÓN → SERV. DB[/b]. Tienes [b]200 segundos[/b]."
}, {
"imagen": null,
"texto": "[b]LOS 6 CABLES:[/b]\n1. ROUTER EDGE → SWITCH CORE (EDGE→SW)\n2. SWITCH CORE → FIREWALL (SW→FW)\n3. FIREWALL → SERV. WEB (FW→WEB)\n4. FIREWALL → SERV. DB (FW→DB)\n5. SWITCH CORE → BASTIÓN (SW→BASTIÓN)\n6. BASTIÓN → SERV. DB (BAST→DB) — la novedad: el bastión administra la base de datos sin cruzar el firewall."
}, {
"imagen": null,
"texto": "[b]BASTIONADO (igual que el nivel 10):[/b]\n• ROUTER EDGE: ACTIVA HTTPS y SNMP v3.\n• SWITCH CORE: ACTIVA VLAN y Port Security.\n• FIREWALL: DESACTIVA ICMP desde WAN y ACTIVA IDS/IPS.\n• SERV. WEB: ACTIVA Parche CVE-2026-3142 y TLS 1.3.\n• SERV. DB: DESACTIVA root remoto y ACTIVA Backups cifrados diarios.\n• BASTIÓN: ACTIVA Auditoría de sesiones y MFA en bastión."
}, {
"imagen": null,
"texto": "[b]BALANCE FINAL:[/b] 6 cables + 12 ajustes en 200 s. Si la auditoría falla, fíjate en el motivo del paquete de FALLO: CABLE u HARDENING, y corrige solo eso antes de relanzar.\n\nMáximo 3 intentos. Cada segundo sobrante: [b]+10 PTS[/b]."
}])
tiene_demo_jugable = false
titulo_ui = "TUTORIAL NIVEL 11"
tipo_nivel = 0
