[ext_resource type="Script" uid="uid://geoqhb1uar6d" path="res://scripts/data/NivelTutorialData.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
paginas_teoria = Array[Dictionary]([{
"imagen": null,
"texto": "[b]NIVEL 8 - INTEGRADO DMZ[/b]\n\nRed con zona desmilitarizada: entra el [b]PROXY DMZ[/b]. Son [b]6 equipos[/b] y [b]160 segundos[/b] para cablear Y bastionar."
}, {
"imagen": null,
"texto": "[b]LOS 5 CABLES:[/b]\n1. ROUTER EDGE → SWITCH CORE (EDGE→SW)\n2. SWITCH CORE → FIREWALL (SW→FW)\n3. FIREWALL → SERV. WEB (FW→WEB)\n4. FIREWALL → SERV. DB (FW→DB)\n5. SWITCH CORE → PROXY DMZ (SW→PROXY)\n\nEl PROXY DMZ (abajo a la izquierda) cuelga directamente del SWITCH CORE, NO del firewall."
}, {
"imagen": null,
"texto": "[b]BASTIONADO - RED:[/b]\n• ROUTER EDGE: ACTIVA HTTPS habilitado (443) y SNMP v3 configurado.\n• SWITCH CORE: ACTIVA VLAN de servidores segmentada y Port Security activado.\n• FIREWALL: DESACTIVA ICMP desde WAN permitido y ACTIVA IDS/IPS en línea."
}, {
"imagen": null,
"texto": "[b]BASTIONADO - SERVIDORES:[/b]\n• SERV. WEB: ACTIVA Parche CVE-2026-3142 y TLS 1.3 habilitado.\n• SERV. DB: DESACTIVA Conexiones root remotas y ACTIVA Backups cifrados diarios.\n• PROXY DMZ: ACTIVA Inspección TLS activa (la Caché de seguridad ya viene encendida).\n\nAuditoría final con ENTER o LANZAR TEST. Fallo: [b]-150 PTS[/b]."
}])
tiene_demo_jugable = false
titulo_ui = "TUTORIAL NIVEL 8"
tipo_nivel = 0
