[resource]
script = ExtResource("1_script")
paginas_teoria = Array[Dictionary]([{
"imagen": null,
"texto": "[b]NIVEL 12 - CAPSTONE EMPRESARIAL[/b]\n\nEXAMEN FINAL: misma arquitectura de tres capas del nivel 11 pero con [b]240 segundos[/b] y cero conceptos nuevos. Demuestra todo lo aprendido en una sola partida."
}, {
"imagen": null,
"texto": "[b]REPASO - LOS 6 CABLES:[/b]\n1. ROUTER EDGE → SWITCH CORE (EDGE→SW)\n2. SWITCH CORE → FIREWALL (SW→FW)\n3. FIREWALL → SERV. WEB (FW→WEB)\n4. FIREWALL → SERV. DB (FW→DB)\n5. SWITCH CORE → BASTIÓN (SW→BASTIÓN)\n6. BASTIÓN → SERV. DB (BAST→DB)"
}, {
"imagen": null,
"texto": "[b]REPASO - BASTIONADO:[/b]\n• ROUTER EDGE: ACTIVA HTTPS y SNMP v3.\n• SWITCH CORE: ACTIVA VLAN y Port Security.\n• FIREWALL: DESACTIVA ICMP desde WAN y ACTIVA IDS/IPS.\n• SERV. WEB: ACTIVA Parche CVE-2026-3142 y TLS 1.3.\n• SERV. DB: DESACTIVA root remoto y ACTIVA Backups cifrados diarios.\n• BASTIÓN: ACTIVA Auditoría de sesiones y MFA en bastión.\n\nLas trampas (ICMP WAN y root remoto) SIEMPRE desactivadas."
}, {
"imagen": null,
"texto": "[b]ESTRATEGIA DE ORO:[/b] encadena los 6 cables sin pausa y luego bastiona nodo por nodo. Con 240 s hay margen para el bonus máximo ([b]+10 PTS[/b]/segundo) si no fallas.\n\nTienes 3 intentos de auditoría. ¡Suerte, analista!"
}])
tiene_demo_jugable = false
titulo_ui = "TUTORIAL NIVEL 12"
tipo_nivel = 0
